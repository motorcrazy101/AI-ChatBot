# Kindroid API Configuration
KINDROID_INFER_URL=https://api.kindroid.ai/v1/discord-bot
KINDROID_API_KEY=your_kindroid_api_key_here

# Bot Configurations
# Add as many numbered sets as needed (1, 2, 3, etc.)
# Required for each bot:
# - SHARED_AI_CODE_N: The shared AI code for API calls
# - BOT_TOKEN_N: Discord bot token
# Optional for each bot:
# - ENABLE_FILTER_N: Enable NSFW filtering (true/false)

# Bot 1 Configuration
SHARED_AI_CODE_1=your_shared_code_1_here
BOT_TOKEN_1=your_discord_bot_token_1_here
ENABLE_FILTER_1=false

# Bot 2 Configuration, add more by incrementing the _number
# SHARED_AI_CODE_2=your_shared_code_2_here
# BOT_TOKEN_2=your_discord_bot_token_2_here
# ENABLE_FILTER_2=false

# ---- Chat logging (optional) ----
# Postgres connection for saving chats. On Railway set this to: ${{Postgres.DATABASE_URL}}
# Leave unset to turn chat saving off.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# ---- Optional tuning (defaults shown) ----
# Message posted in Discord when something breaks
# ERROR_MESSAGE=The Asylum Warden put a gag in her mouth. Please contact the Asylum Warden (SelfCenteredDouchebag) if this response pops up!
# How many recent messages the AI sees as context (max 100)
# CONTEXT_MESSAGE_LIMIT=30
# Max bot messages in a row before bots stop answering each other
# MAX_BOT_CHAIN=3
# How long to wait for Kindroid before giving up (milliseconds)
# KINDROID_TIMEOUT_MS=60000
