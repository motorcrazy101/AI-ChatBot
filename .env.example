# On Railway, put these in your bot service's Variables tab — never in GitHub.

# Kindroid API Configuration
KINDROID_INFER_URL=https://api.kindroid.ai/v1/discord-bot
KINDROID_API_KEY=your_kindroid_api_key_here

# Bot Configurations
# Add as many numbered sets as needed (1, 2, 3, etc.)
# Required for each bot:
# - SHARED_AI_CODE_N: The shared AI code for API calls
# - BOT_TOKEN_N: Discord bot token
# Optional for each bot:
# - ENABLE_FILTER_N: Enable NSFW filtering (true/false)
# - BOT_STATUS_N: Status under the bot's name, e.g. "Playing in the Asylum",
#   "Watching over the server", "Listening to the rain", or any plain text.
#   (Can also be changed later with /aurora status.)

# Bot 1 Configuration
SHARED_AI_CODE_1=your_shared_code_1_here
BOT_TOKEN_1=your_discord_bot_token_1_here
ENABLE_FILTER_1=false
# BOT_STATUS_1=Playing in the Asylum

# Bot 2 Configuration, add more by incrementing the _number
# SHARED_AI_CODE_2=your_shared_code_2_here
# BOT_TOKEN_2=your_discord_bot_token_2_here
# ENABLE_FILTER_2=false
# BOT_STATUS_2=Watching the chaos

# ---- Database (recommended) ----
# Saves chats and keeps /command settings after restarts.
# On Railway set this to: ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:password@host:5432/railway

# ---- Chat log web page (optional) ----
# Set a password to turn on the page, then in Railway go to
# Settings → Networking → Generate Domain to get its web address.
# LOG_VIEWER_PASSWORD=pick-a-long-password

# ---- Optional tuning (defaults shown) ----
# Time zone for scheduled posts and the chat log page
# TIMEZONE=America/Los_Angeles
# Starting % chance to randomly chime in / react (change later with commands)
# CHIME_CHANCE=5
# REACTION_CHANCE=10
# Minimum minutes between random chime-ins in the same channel
# CHIME_COOLDOWN_MINUTES=10
# Message posted in Discord when something breaks
# ERROR_MESSAGE=The Asylum Warden put a gag in her mouth. Please contact the Asylum Warden (SelfCenteredDouchebag) if this response pops up!
# How many recent messages the AI sees as context (max 100)
# CONTEXT_MESSAGE_LIMIT=30
# Max bot messages in a row before bots stop answering each other
# MAX_BOT_CHAIN=3
# How long to wait for Kindroid before giving up (milliseconds)
# KINDROID_TIMEOUT_MS=60000
