{
  "name": "kindroid-discord",
  "version": "1.0.1",
  "description": "Multi-bot Discord manager for Kindroid AI personas with JIT message fetching",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "kindroid",
    "multi-bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "1.7.9",
    "discord.js": "14.17.3",
    "dotenv": "16.4.7",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "20.17.17",
    "@types/pg": "8.11.10",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "globals": "15.14.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0"
  }
}
